// Custom Nextflow config to patch nf-core/hic 2.1.0 module conda envs.
//
// Why: nf-core/hic 2.1.0 pins `cooler=0.8.11` in five modules
// (makebins, cload, balance, zoomify, dump) without pinning pandas.
// Recent conda solvers install pandas 2.x alongside, but cooler 0.8.11
// imports `pandas.api.types.is_categorical` which was removed in
// pandas 2.0. Result: ImportError at every cooler step.
//
// Fix: pin cooler to 0.10.4. 0.9.x is still incompatible with pandas 3.x
// (which conda solvers now install by default): cooler 0.9.3 uses label-
// based Series.__getitem__ with integer chrom code arrays, which raises
// KeyError under pandas 3.0. cooler 0.10.x replaced that with .iloc[]
// (positional indexing) and is pandas-3-safe. Same CLI surface for all
// the modules we need: makebins, cload, balance, zoomify, dump.

process {
    withName: '.*COOLER_MAKEBINS' {
        conda = "bioconda::cooler=0.10.4"
    }
    withName: '.*COOLER_CLOAD' {
        conda = "bioconda::cooler=0.10.4"
    }
    withName: '.*COOLER_BALANCE' {
        conda = "bioconda::cooler=0.10.4"
    }
    withName: '.*COOLER_ZOOMIFY' {
        conda = "bioconda::cooler=0.10.4"
    }
    withName: '.*COOLER_DUMP' {
        conda = "bioconda::cooler=0.10.4"
    }
    // MULTIQC 1.14 imports `pkg_resources` from setuptools, but recent
    // setuptools (>=81) removed pkg_resources. Combined with python 3.14
    // pulled by the conda solver, this raises ModuleNotFoundError.
    // multiqc 1.25 dropped pkg_resources and works on python 3.12+.
    withName: '.*MULTIQC' {
        conda = "bioconda::multiqc=1.25"
    }
}
